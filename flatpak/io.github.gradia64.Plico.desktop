[Desktop Entry]
Type=Application
Name=Plico
GenericName=PDF Editor
GenericName[it]=Editor PDF
GenericName[es]=Editor de PDF
GenericName[fr]=Éditeur PDF
GenericName[de]=PDF-Editor
Comment=A true native PDF editor for Linux
Comment[it]=Un vero editor PDF nativo per Linux
Comment[es]=Un verdadero editor de PDF nativo para Linux
Comment[fr]=Un véritable éditeur PDF natif pour Linux
Comment[de]=Ein echter nativer PDF-Editor für Linux
Exec=plico %F
Icon=io.github.gradia64.Plico
Terminal=false
Categories=Office;Viewer;Qt;KDE;
MimeType=application/pdf;
Keywords=PDF;editor;page;rotate;merge;extract;redaction;OCR;sign;form;
Keywords[it]=PDF;editor;pagina;pagine;ruota;unisci;estrai;cancella;OCR;firma;modulo;
Keywords[es]=PDF;editor;página;girar;unir;extraer;borrar;OCR;firmar;formulario;
Keywords[fr]=PDF;éditeur;page;pivoter;fusionner;extraire;effacer;OCR;signer;formulaire;
Keywords[de]=PDF;Editor;Seite;drehen;zusammenführen;extrahieren;schwärzen;OCR;signieren;Formular;
StartupNotify=true
