{
  "app-id": "io.github.gradia64.plico",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.PySide.BaseApp",
  "base-version": "6.11",
  "command": "plico",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home"
  ],
  "build-options": {
    "env": {
      "BASEAPP_REMOVE_WEBENGINE": "1",
      "BASEAPP_DISABLE_NUMPY": "1"
    }
  },
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh"
  ],
  "modules": [
    {
      "name": "leptonica",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_SHARED_LIBS=ON",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DENABLE_GIF=OFF",
        "-DENABLE_WEBP=OFF",
        "-DENABLE_OPENJPEG=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/DanBloomberg/leptonica/releases/download/1.84.1/leptonica-1.84.1.tar.gz",
          "sha256": "2b3e1254b1cca381e77c819b59ca99774ff43530209b9aeb511e1d46588a64f6"
        }
      ],
      "builddir": true
    },
    {
      "name": "tesseract",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_SHARED_LIBS=ON",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DINSTALL_CONFIGS=ON",
        "-DSW_BUILD=OFF",
        "-DGRAPHICS_DISABLED=ON",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/man"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.4.1.tar.gz",
          "sha256": "c4bc2a81c12a472f445b7c2fb4705a08bd643ef467f51ec84f0e148bd368051b"
        }
      ],
      "builddir": true
    },
    {
      "name": "tesseract-language-data",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 eng.traineddata -t /app/share/tessdata/",
        "install -Dm644 ita.traineddata -t /app/share/tessdata/",
        "install -Dm644 spa.traineddata -t /app/share/tessdata/",
        "install -Dm644 fra.traineddata -t /app/share/tessdata/",
        "install -Dm644 deu.traineddata -t /app/share/tessdata/"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/eng.traineddata",
          "sha256": "7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/ita.traineddata",
          "sha256": "b8f89e1e785118dac4d51ae042c029a64edb5c3ee42ef73027a6d412748d8827"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/spa.traineddata",
          "sha256": "6f2e04d02774a18f01bed44b1111f2cd7f3ba7ac9dc4373cd3f898a40ea6b464"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/fra.traineddata",
          "sha256": "ced037562e8c80c13122dece28dd477d399af80911a28791a66a63ac1e3445ca"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/87416418657359cb625c412a48b6e1d6d41c29bd/deu.traineddata",
          "sha256": "19d219bbb6672c869d20a9636c6816a81eb9a71796cb93ebe0cb1530e2cdb22d"
        }
      ]
    },
    "python3-pyhanko.json",
    "python3-pymupdf.json",
    "python3-pikepdf.json",
    {
      "name": "plico",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-build-isolation --no-deps --prefix=/app .",
        "install -d /app/share/plico/translations",
        "for ts in src/plico/translations/*.ts; do name=$(basename \"$ts\" .ts); lrelease \"$ts\" -qm \"/app/share/plico/translations/$name.qm\"; done"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            ".git",
            ".venv",
            ".mypy_cache",
            ".pytest_cache",
            ".ruff_cache",
            "build",
            "dist"
          ]
        }
      ]
    }
  ]
}
